{
  "name": "@jannchie/slides",
  "version": "0.1.0",
  "description": "Slide decks as constrained HTML, and an editor for them: the format, its render tree, a canvas editor with presenter and PPTX export, for Vue, React or any page",
  "license": "MIT",
  "author": "Jianqi Pan <jannchie@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jannchie/slides.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/style.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom.ts",
    "./editor": "./src/editor/index.ts",
    "./vue": "./src/editor/vue.ts",
    "./react": "./src/editor/react.tsx",
    "./pptx": "./src/editor/pptx.ts",
    "./uno": "./src/editor/uno.ts",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dom": {
        "types": "./dist/types/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "./editor": {
        "types": "./dist/types/editor/index.d.ts",
        "default": "./dist/editor.js"
      },
      "./vue": {
        "types": "./dist/types/editor/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "./react": {
        "types": "./dist/types/editor/react.d.ts",
        "default": "./dist/react.js"
      },
      "./pptx": {
        "types": "./dist/types/editor/pptx.d.ts",
        "default": "./dist/pptx.js"
      },
      "./uno": {
        "types": "./dist/types/editor/uno.d.ts",
        "default": "./dist/uno.js"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "icons": "node scripts/generate-icons.mjs && oxfmt src/deck-icons.ts"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@vueuse/core": "^15.0.0",
    "pptxgenjs": "^4.0.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@jannchie/iconify-json": "^0.7.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-icons": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "unocss": "^66.10.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@jannchie/iconify-json": ">=0.7.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@jannchie/iconify-json": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
